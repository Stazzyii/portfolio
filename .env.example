# Copy these into your hosting provider's Environment Variables settings
# (Vercel → Project → Settings → Environment Variables). Never commit real values.

# Required for the /api/contact email function (https://resend.com)
RESEND_API_KEY=
# Where enquiries are delivered (your inbox)
CONTACT_TO_EMAIL=
# A sender on a domain you've verified in Resend, e.g. "Portfolio <hello@your-domain.com>"
CONTACT_FROM_EMAIL=
# Optional: only accept submissions from your site, e.g. https://your-domain.com
ALLOWED_ORIGIN=
